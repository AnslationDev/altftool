node_modules/
# npm workspaces: the root package-lock.json is the single source of truth.
# Nested workspace lockfiles drift out of sync (root `npm install` never
# updates them) and must never be committed — they are what broke `npm ci`.
altftoolweb/package-lock.json
altftoolwebadmin/package-lock.json
packages/*/package-lock.json
.DS_Store
.env
.env.*
.next/
out/
dist/
coverage/
test-results/
playwright-report/
.vercel
# Firebase deploy cache
.firebase/
# Local debug/scratch leftovers
**/__orig_test.mjs
# External repos
get-shit-done/
graphify*/
external-get-shit-done/
# Ignore all local env files...
.env*
agents.md
master.md
claude.md
# ...but keep the committed templates (this exception MUST come after .env*)
!.env.example
!**/.env.example

# temp local assets (not for the repo)
/pppd.png

# Claude Code session/tooling data
.claude/
