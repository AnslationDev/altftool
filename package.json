{
  "name": "altftool",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "altftoolweb",
    "altftoolwebadmin",
    "packages/*"
  ],
  "scripts": {
    "brand:sync": "node scripts/sync-brand-assets.mjs",
    "design:check": "node scripts/check-design-system.mjs",
    "design:sync": "npm run brand:sync && npm run design:check",
    "build": "npm run build:web && npm run seo:route-quality:report && npm run build:admin",
    "build:web": "node scripts/run-with-node-memory.mjs npm --prefix altftoolweb run build",
    "build:admin": "node scripts/run-with-node-memory.mjs npm --prefix altftoolwebadmin run build",
    "bundle:audit": "node scripts/check-bundle-budgets.mjs",
    "dev": "concurrently -n web,admin -c cyan,magenta \"npm run dev:web\" \"npm run dev:admin\"",
    "dev:web": "npm --prefix altftoolweb run dev -- -p 3002",
    "dev:admin": "npm --prefix altftoolwebadmin run dev -- -p 3001",
    "start:web": "npm --prefix altftoolweb run start -- -p 3002",
    "start:admin": "npm --prefix altftoolwebadmin run start -- -p 3001",
    "lint:web": "npm --prefix altftoolweb run lint -- --quiet",
    "lint:web:budget": "node scripts/check-web-lint-budget.mjs",
    "performance:budget": "node scripts/check-performance-budgets.mjs",
    "performance:budget:report": "node scripts/check-performance-budgets.mjs --strict --require-build --output=altftoolwebadmin/src/data/performanceBudgetReport.json",
    "performance:budget:strict": "node scripts/check-performance-budgets.mjs --strict --require-build",
    "audit": "npm run audit:web && npm run audit:admin",
    "audit:web": "node scripts/audit-workspace-dependencies.mjs altftoolweb",
    "audit:admin": "node scripts/audit-workspace-dependencies.mjs altftoolwebadmin",
    "routes:check": "node scripts/check-routes.mjs",
    "qa:routes": "node scripts/check-route-qa-report.mjs",
    "qa:routes:browser": "node scripts/check-route-qa-report.mjs --browser-only",
    "qa:routes:strict": "node scripts/check-route-qa-report.mjs --strict --warm",
    "qa:routes:full": "ALTFT_ROUTE_QA_SCOPE=full node scripts/check-route-qa-report.mjs",
    "qa:routes:runtime-full": "ALTFT_ROUTE_QA_SCOPE=full node scripts/check-route-qa-report.mjs --browser-scope=full --no-mobile",
    "qa:routes:runtime-full:shard": "ALTFT_ROUTE_QA_SCOPE=full node scripts/check-route-qa-report.mjs --browser-scope=full --no-mobile",
    "qa:routes:runtime-full:sharded": "node scripts/run-route-qa-shards.mjs",
    "qa:routes:visual-full": "ALTFT_ROUTE_QA_SCOPE=full node scripts/check-route-qa-report.mjs --browser-scope=full --mobile-scope=full",
    "qa:routes:inventory": "node scripts/check-route-qa-report.mjs --dry-run --no-browser",
    "qa:routes:report": "node scripts/check-route-qa-report.mjs --warm --output=altftoolwebadmin/src/data/routeQaReport.json",
    "env:readiness": "node scripts/check-env-readiness.mjs",
    "env:readiness:strict": "ALTFT_ENV_STRICT=true node scripts/check-env-readiness.mjs --strict",
    "security:secrets": "node scripts/check-secret-hygiene.mjs",
    "health:manifest": "node scripts/generate-admin-health-manifest.mjs",
    "health:manifest:canonical": "node scripts/generate-admin-health-manifest.mjs --canonical",
    "health:manifest:check": "npm run health:manifest:canonical && git diff --exit-code -- altftoolwebadmin/src/data/healthManifest.json altftoolwebadmin/src/data/toolReadinessReport.json",
    "tools:readiness": "npm --prefix altftoolweb run generate:registry && npm run health:manifest && node scripts/check-tool-readiness.mjs",
    "tools:readiness:strict": "npm --prefix altftoolweb run generate:registry && npm run health:manifest && node scripts/check-tool-readiness.mjs --strict",
    "deploy:readiness": "node scripts/check-vercel-deploy-readiness.mjs",
    "deploy:source-check": "node scripts/check-vercel-source.mjs",
    "deploy:parity": "node scripts/check-live-deploy-parity.mjs",
    "deploy:parity:strict": "node scripts/check-live-deploy-parity.mjs --strict --require-commit --no-browser",
    "firebase:check": "node scripts/check-firebase-contracts.mjs",
    "firebase:integrity": "node scripts/check-firebase-data-integrity.mjs",
    "firebase:integrity:report": "node scripts/check-firebase-data-integrity.mjs --strict --output=altftoolwebadmin/src/data/firebaseDataIntegrityReport.json",
    "firebase:integrity:strict": "node scripts/check-firebase-data-integrity.mjs --strict",
    "firebase:live-check": "node scripts/check-firebase-live-data.mjs",
    "firebase:live-check:strict": "node scripts/check-firebase-live-data.mjs --strict",
    "firebase:blogs-read-check": "node scripts/check-blog-firebase-read.mjs",
    "firebase:admin-write-check": "npm --prefix altftoolwebadmin run firebase:admin-write-check",
    "firebase:admin-write-check:dry-run": "npm --prefix altftoolwebadmin run firebase:admin-write-check:dry-run",
    "firebase:emulator:preflight": "node scripts/check-firebase-emulator-prereqs.mjs",
    "firebase:admin-write-check:emulator": "npm run firebase:emulator:preflight && npx --yes firebase-tools@15.17.0 emulators:exec --only firestore --project altftool-bca36 \"npm --prefix altftoolwebadmin run firebase:admin-write-check\"",
    "media:check": "node scripts/check-public-media-budgets.mjs",
    "monitor:production": "node scripts/check-production-monitoring.mjs",
    "monitor:production:strict": "ALTFT_MONITOR_REQUIRE_ADMIN=true ALTFT_MONITOR_REQUIRE_ADMIN_AUTH=true node scripts/check-production-monitoring.mjs",
    "monitor:links": "node scripts/check-production-surface-links.mjs",
    "monitor:links:report": "node scripts/check-production-surface-links.mjs --strict --output=altftoolwebadmin/src/data/productionLinksReport.json",
    "monitor:links:strict": "node scripts/check-production-surface-links.mjs --strict",
    "release:preflight": "node scripts/run-release-preflight.mjs",
    "release:doctor": "node --no-warnings scripts/run-release-doctor.mjs",
    "release:doctor:report": "node --no-warnings scripts/run-release-doctor.mjs --output=altftoolwebadmin/src/data/releaseDoctorReport.json",
    "release:doctor:strict": "node --no-warnings scripts/run-release-doctor.mjs --strict",
    "release:history:report": "node scripts/update-release-history.mjs --output=altftoolwebadmin/src/data/releaseHistoryReport.json",
    "content:blogs": "node scripts/check-blog-content-health.mjs",
    "content:blogs:live": "node scripts/check-blog-content-health.mjs --live",
    "content:blogs:report": "node scripts/check-blog-content-health.mjs --output=altftoolwebadmin/src/data/blogContentHealthReport.json",
    "seo:routes": "node --no-warnings scripts/audit-public-seo.mjs",
    "seo:routes:write": "node --no-warnings scripts/audit-public-seo.mjs --write",
    "seo:rendered": "node --no-warnings scripts/audit-rendered-seo.mjs",
    "seo:route-quality": "node scripts/run-with-node-memory.mjs node --no-warnings scripts/generate-route-quality-report.mjs",
    "seo:route-quality:report": "node scripts/run-with-node-memory.mjs node --no-warnings scripts/generate-route-quality-report.mjs --output=altftoolwebadmin/src/data/routeQualityReport.json",
    "seo:route-quality:strict": "node scripts/run-with-node-memory.mjs node --no-warnings scripts/generate-route-quality-report.mjs --strict-quality",
    "seo:index-control": "node scripts/run-with-node-memory.mjs node --no-warnings scripts/generate-route-quality-report.mjs --strict",
    "seo:schema": "node --no-warnings scripts/audit-rendered-schema.mjs",
    "seo:blog-check": "node --no-warnings scripts/check-blog-seo-readiness.mjs",
    "seo:blog-links": "node --no-warnings scripts/check-blog-internal-links.mjs",
    "seo:blog-links-live": "node --no-warnings scripts/check-blog-internal-links.mjs --live",
    "seo:blog-live-check": "node --no-warnings scripts/check-blog-seo-readiness.mjs --live",
    "tools:check": "node --no-warnings scripts/check-tool-registry.mjs",
    "test:firebase-rules": "npm --prefix altftoolwebadmin run test:firebase-rules",
    "test:firebase-rules:emulator": "npm run firebase:emulator:preflight && npx --yes firebase-tools@15.17.0 emulators:exec --only firestore,storage --project altftool-bca36 \"npm run test:firebase-rules\"",
    "test:admin-crud": "npm --prefix altftoolwebadmin run test:admin-crud",
    "test:admin-crud:emulator": "npm run firebase:emulator:preflight && npx --yes firebase-tools@15.17.0 emulators:exec --only firestore --project altftool-bca36 \"npm run test:admin-crud\"",
    "test:admin-web-sync": "npm --prefix altftoolwebadmin run test:admin-web-sync",
    "test:admin-web-sync:emulator": "npm run firebase:emulator:preflight && npx --yes firebase-tools@15.17.0 emulators:exec --only firestore --project altftool-bca36 \"npm run test:admin-web-sync\"",
    "test:firebase-admin-write-check": "node --test tests/firebase-admin-write-check.test.mjs",
    "test:firebase-data-integrity": "node --test tests/firebase-data-integrity.test.mjs",
    "test:firebase-live-data-report": "node --test tests/firebase-live-data-report.test.mjs",
    "test:route-quality-seo": "node --test tests/route-quality-seo.test.mjs",
    "test:resilient-fetch": "node --test tests/resilient-json-fetch.test.mjs",
    "test:smoke": "playwright test tests/smoke.spec.mjs",
    "test:theme": "playwright test tests/theme-system.spec.mjs",
    "test:tools:functional": "ALTFT_PLAYWRIGHT_WEB_SERVER=production ALTFT_SKIP_ADMIN_SERVER=true playwright test tests/tool-functional.spec.mjs",
    "test:tools:api-readiness": "ALTFT_SKIP_ADMIN_SERVER=true playwright test tests/api-tool-readiness.spec.mjs",
    "test:tools:priority": "ALTFT_SKIP_ADMIN_SERVER=true playwright test tests/tool-priority.spec.mjs",
    "test:tools:priority:production": "ALTFT_PLAYWRIGHT_WEB_SERVER=production ALTFT_SKIP_ADMIN_SERVER=true playwright test tests/tool-priority.spec.mjs",
    "test:tools:all": "playwright test tests/tool-all-routes.spec.mjs",
    "test:routes": "npm run test:routes:admin:dev && npm run test:routes:web:production",
    "test:routes:web:production": "ALTFT_PLAYWRIGHT_WEB_SERVER=production ALTFT_SKIP_ADMIN_SERVER=true playwright test tests/route-audit.spec.mjs --grep \"public web route surface resolves|seo endpoints and structured data render\"",
    "test:routes:admin:dev": "ALTFT_SKIP_WEB_SERVER=true playwright test tests/route-audit.spec.mjs --grep \"admin public and fallback routes resolve|admin module route surface resolves\"",
    "test:routes:dev": "playwright test tests/route-audit.spec.mjs",
    "test:admin-api": "playwright test tests/admin-api.spec.mjs",
    "test:admin-api:dev": "ALTFT_SKIP_WEB_SERVER=true playwright test tests/admin-api.spec.mjs",
    "test:admin:dev": "ALTFT_SKIP_WEB_SERVER=true playwright test tests/route-audit.spec.mjs tests/admin-api.spec.mjs --grep \"admin public and fallback routes resolve|admin module route surface resolves|admin API safety\" --workers=1",
    "test:admin:ci": "ALTFT_ADMIN_MODULE_ROUTE_LIMIT=8 ALTFT_ADMIN_MODULE_ROUTE_TIMEOUT_MS=120000 ALTFT_ADMIN_MODULE_ROUTE_AUDIT_TIMEOUT_MS=720000 ALTFT_SKIP_WEB_SERVER=true playwright test tests/route-audit.spec.mjs tests/admin-api.spec.mjs --grep \"admin public and fallback routes resolve|admin module route surface resolves|admin API safety\" --workers=1",
    "test:admin-blog-ux": "playwright test tests/admin-blog-ux.spec.mjs",
    "test:admin-mobile-ux": "ALTFT_ADMIN_URL=http://localhost:3011 playwright test tests/admin-mobile-ux.spec.mjs",
    "test:admin-routes": "ALTFT_SKIP_WEB_SERVER=true ALTFT_ADMIN_URL=http://localhost:3011 playwright test tests/admin-route-qa.spec.mjs",
    "test:firebase-public-pages": "playwright test tests/firebase-public-pages.spec.mjs",
    "test:firebase-public-pages:production": "ALTFT_PLAYWRIGHT_WEB_SERVER=production ALTFT_SKIP_ADMIN_SERVER=true playwright test tests/firebase-public-pages.spec.mjs",
    "test:blogs-public-ux": "ALTFT_SKIP_ADMIN_SERVER=true playwright test tests/blog-public-ux.spec.mjs",
    "test:blogs-mobile-engagement": "NEXT_PUBLIC_FIREBASE_PROJECT_ID=build-placeholder ALTFT_FIRESTORE_REST_TIMEOUT_MS=500 ALTFT_SKIP_ADMIN_SERVER=true playwright test tests/blog-mobile-engagement.spec.mjs",
    "test:blogs-a11y-seo": "NEXT_PUBLIC_FIREBASE_PROJECT_ID=build-placeholder ALTFT_FIRESTORE_REST_TIMEOUT_MS=500 ALTFT_SKIP_ADMIN_SERVER=true playwright test tests/blog-accessibility-seo.spec.mjs",
    "test:blogs-comments-ux": "NEXT_PUBLIC_FIREBASE_PROJECT_ID=build-placeholder ALTFT_FIRESTORE_REST_TIMEOUT_MS=500 ALTFT_SKIP_ADMIN_SERVER=true playwright test tests/blog-comments-ux.spec.mjs",
    "test:mobile-ux": "ALTFT_SKIP_ADMIN_SERVER=true playwright test tests/mobile-ux.spec.mjs",
    "test:mobile-ux:production": "ALTFT_PLAYWRIGHT_WEB_SERVER=production ALTFT_SKIP_ADMIN_SERVER=true playwright test tests/mobile-ux.spec.mjs",
    "test:visual": "NEXT_PUBLIC_USE_MOCK=true NEXT_PUBLIC_DISABLE_LOCAL_ADMIN=true playwright test tests/visual.spec.mjs",
    "test:visual:production": "NEXT_PUBLIC_USE_MOCK=true NEXT_PUBLIC_DISABLE_LOCAL_ADMIN=true ALTFT_PLAYWRIGHT_WEB_SERVER=production ALTFT_PLAYWRIGHT_ADMIN_SERVER=production playwright test tests/visual.spec.mjs",
    "test:visual:update": "NEXT_PUBLIC_USE_MOCK=true NEXT_PUBLIC_DISABLE_LOCAL_ADMIN=true playwright test tests/visual.spec.mjs --update-snapshots",
    "test:security": "npm run security:secrets && playwright test tests/security.spec.mjs",
    "test:security:production": "npm run security:secrets && ALTFT_PLAYWRIGHT_WEB_SERVER=production ALTFT_PLAYWRIGHT_ADMIN_SERVER=production playwright test tests/security.spec.mjs",
    "test:lighthouse": "ALTFT_PLAYWRIGHT_WEB_SERVER=production ALTFT_PLAYWRIGHT_ADMIN_SERVER=dev playwright test tests/lighthouse.spec.mjs",
    "test:lighthouse:production": "ALTFT_PLAYWRIGHT_WEB_SERVER=production ALTFT_SKIP_ADMIN_SERVER=true playwright test tests/lighthouse.spec.mjs",
    "test:lighthouse:dev": "playwright test tests/lighthouse.spec.mjs",
    "test:core-cache": "node --test tests/core-cache.test.mjs",
    "test:catalogs": "node --test tests/experience-catalog.test.mjs tests/product-registry.test.mjs tests/public-docs.test.mjs tests/site-map-data.test.mjs tests/tool-seo-map.test.mjs",
    "test:live-deploy-parity": "node --test tests/live-deploy-parity.test.mjs",
    "test:performance-budget": "node --test tests/performance-budget.test.mjs",
    "test:production-surface-links": "node --test tests/production-surface-links.test.mjs",
    "test:release-doctor": "node --test tests/release-doctor.test.mjs",
    "test:release-history": "node --test tests/release-history-report.test.mjs",
    "test:route-loading": "node --test tests/route-loading-files.test.mjs tests/browser-image-constructor-shadowing.test.mjs tests/admin-global-not-found.test.mjs",
    "test:tool-readiness": "node --test tests/tool-readiness-report.test.mjs",
    "test:search-engine": "node --test tests/search-engine.test.mjs",
    "test:seo-config-source": "node --test tests/seo-config-source.test.mjs",
    "test:seo-site-url": "node --test tests/site-url-seo.test.mjs",
    "test:seo-sitemap-xml": "node --test tests/sitemap-xml-safety.test.mjs",
    "test:seo-verification": "node --test tests/seo-verification-tokens.test.mjs",
    "test:seo-indexnow": "node --test tests/indexnow-submission.test.mjs",
    "test:route-qa-report": "node --test tests/route-qa-report.test.mjs tests/rendered-sitemap.test.mjs",
    "test:dependency-audit-policy": "node --test tests/dependency-audit-policy.test.mjs",
    "test:node-memory-policy": "node --test tests/node-memory-policy.test.mjs",
    "validate:admin-ux-release": "node scripts/run-admin-ux-release-validation.mjs",
    "validate:ux-release": "node scripts/run-ux-release-validation.mjs",
    "validate:ux-release:live": "node scripts/run-ux-release-validation.mjs --live-parity",
    "validate:runtime-quality": "npm run qa:routes:strict && npm run firebase:live-check:strict && npm run firebase:integrity:strict && npm run performance:budget:strict",
    "validate": "npm run design:check && npm run security:secrets && npm run lint:web && npm run lint:web:budget && npm run routes:check && npm run seo:routes && npm run test:seo-site-url && npm run test:seo-sitemap-xml && npm run test:seo-verification && npm run test:seo-indexnow && npm run test:seo-config-source && npm run test:core-cache && npm run test:search-engine && npm run test:tool-readiness && npm run test:route-qa-report && npm run test:dependency-audit-policy && npm run test:node-memory-policy && npm run test:performance-budget && npm run test:firebase-data-integrity && npm run test:resilient-fetch && npm run test:production-surface-links && npm run test:release-doctor && npm run test:release-history && npm run test:live-deploy-parity && npm run tools:check && npm run tools:readiness:strict && npm run content:blogs && npm run seo:blog-check && npm run seo:blog-links && npm run health:manifest:check && npm run env:readiness && npm run firebase:check && npm run media:check && npm run audit && npm run build && npm run seo:schema && npm run seo:rendered && npm run seo:index-control && npm run seo:route-quality:strict && npm run bundle:audit && npm run performance:budget:strict && ALTFT_WEB_URL=http://localhost:3102 ALTFT_ADMIN_URL=http://localhost:3101 ALTFT_PLAYWRIGHT_WEB_SERVER=production ALTFT_PLAYWRIGHT_ADMIN_SERVER=production npm run test:smoke",
    "validate:full": "npm run validate && npm run test:routes:web:production && npm run test:tools:functional && npm run test:tools:priority:production && npm run test:mobile-ux:production && npm run test:firebase-admin-write-check && npm run test:firebase-live-data-report",
    "validate:release": "npm run validate:full && npm run firebase:live-check && npm run seo:blog-live-check && npm run test:firebase-public-pages:production && npm run test:security:production && npm run test:visual:production && npm run test:lighthouse:production"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "autoprefixer": "^10.5.0",
    "chrome-launcher": "^1.2.1",
    "concurrently": "^10.0.3",
    "lighthouse": "^12.6.1",
    "postcss": "8.5.25",
    "tailwindcss": "^4.2.4"
  },
  "overrides": {
    "fast-xml-parser": "5.10.1",
    "dompurify": "3.4.12",
    "brace-expansion@1.1.16": "1.1.18",
    "brace-expansion@2.1.2": "2.1.4",
    "brace-expansion@2.1.3": "2.1.4",
    "brace-expansion@5.0.7": "5.0.9",
    "brace-expansion@5.0.8": "5.0.9",
    "postcss": "8.5.25",
    "next": {
      "postcss": "8.5.25"
    },
    "pdfjs-dist": "5.3.93",
    "websocket-driver": "0.7.5",
    "@monaco-editor/react": {
      "monaco-editor": "$monaco-editor"
    }
  },
  "dependencies": {
    "@prettier/plugin-php": "^0.25.0",
    "heic2any": "^0.0.4",
    "monaco-editor": "0.53.0",
    "prettier": "^3.9.5",
    "sharp": "0.35.3"
  }
}
