rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function rbacAdminDoc() {
      return /databases/$(database)/documents/super_admin_dashboard/main/admin_users/$(request.auth.uid);
    }

    function isLegacyActiveAdmin() {
      return signedIn() &&
        exists(adminDoc()) &&
        get(adminDoc()).data.isActive == true;
    }

    // Mirror serverRbac.js normalizeStatus(): an explicit `status` wins; when it
    // is absent (legacy/migrated admin docs that stored only `isActive: true`),
    // the admin is active unless `isActive` is explicitly false. Previously this
    // required status == "active", so those legacy docs were treated as active by
    // the server (admin could log in and SEE the panel) but were denied every
    // Firestore write — e.g. creating an Ad failed with "insufficient permissions".
    function rbacDocActive(data) {
      return data.get("status", data.get("isActive", true) ? "active" : "suspended") == "active";
    }

    function isRbacActiveAdmin() {
      return signedIn() &&
        exists(rbacAdminDoc()) &&
        rbacDocActive(get(rbacAdminDoc()).data);
    }

    function isActiveAdmin() {
      return isLegacyActiveAdmin() || isRbacActiveAdmin();
    }

    function isSuperAdmin() {
      return (
        isLegacyActiveAdmin() &&
        get(adminDoc()).data.roleType == "superadmin"
      ) || (
        isRbacActiveAdmin() &&
        (
          get(rbacAdminDoc()).data.isSuperAdmin == true ||
          get(rbacAdminDoc()).data.roleId == "super_admin" ||
          get(rbacAdminDoc()).data.roleType == "superadmin"
        )
      );
    }

    function hasOnly(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function nonEmptyText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    match /admins/{uid} {
      allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (signedIn() &&
          request.auth.uid == uid &&
          onlyChanges(["bio", "designation", "firstName", "fullName", "lastName", "photoURL", "team"]));
    }

    match /accessRequests/{requestId} {
      allow read, update, delete: if isSuperAdmin();
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == "pending";
    }

    match /super_admin_dashboard/{dashboardId} {
      allow read, write: if isSuperAdmin();

      match /admin_users/{uid} {
        allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);
        allow create, delete: if isSuperAdmin();
        allow update: if isSuperAdmin() ||
          (signedIn() &&
            request.auth.uid == uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["bio", "designation", "firstName", "fullName", "lastName", "photoURL", "team", "updatedAt"]));

        match /project_access/{projectId} {
          allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);
          allow write: if isSuperAdmin();

          match /modules/{moduleId} {
            allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);
            allow write: if isSuperAdmin();
          }
        }

        match /sessions/{sessionId} {
          allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);
          allow create, update: if signedIn() && request.auth.uid == uid;
          allow delete: if isSuperAdmin();
        }
      }

      match /admin_roles/{roleId} {
        allow read: if isActiveAdmin();
        allow write: if isSuperAdmin();
      }

      match /admin_audit_logs/{logId} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }

      match /admin_sessions/{sessionId} {
        allow read, write: if isSuperAdmin();
      }

      match /admin_security_events/{eventId} {
        allow read: if isSuperAdmin();
        allow create: if isActiveAdmin();
        allow update, delete: if isSuperAdmin();
      }

      match /admin_access_requests/{requestId} {
        allow read, update, delete: if isSuperAdmin();
        allow create: if signedIn() &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.status == "pending";
      }

      match /admin_settings/{settingId} {
        allow read: if isActiveAdmin();
        allow write: if isSuperAdmin();
      }
    }

    // Unified activity events (Workspace Management System). Written by the
    // Admin SDK only (tamper-proof from the browser); read by super admins.
    // Project-scoped read filtering is enforced in the read API layer.
    match /activity_events/{eventId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /activity_rollups/{rollupId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /projects/altftool/blogs/{blogId} {
      allow read: if true;
      // Public engagement counters the web app increments anonymously. The
      // web already writes helpful/notHelpful/feedback and tool-click fields —
      // they were missing here, which raised console permission errors for
      // every visitor on the blog detail page.
      allow update: if onlyChanges([
        "commentsCount", "likesCount", "views", "viewsCount",
        "helpfulCount", "notHelpfulCount", "feedbackCount",
        "toolClickCount", "toolClicksBySlug", "lastToolClick"
      ]);
      allow create, delete: if isActiveAdmin();

      match /views/{viewId} {
        allow read: if false;
        allow create: if hasOnly(["viewedAt"]);
      }

      // Per-session reader feedback docs written by BlogFeedback (anonymous).
      match /feedback/{sessionId} {
        allow read: if false;
        allow create, update: if true;
        allow delete: if isActiveAdmin();
      }
    }

    match /projects/altftool/pintrest/{pinId} {
      allow read: if true;
      allow update: if onlyChanges(["likes"]) || isActiveAdmin();
      allow create, delete: if isActiveAdmin();
    }

    match /projects/altftool/pintrest_categories/{catId} {
      allow read: if true;
      allow create, update, delete: if isActiveAdmin();
    }

    // Editorial metadata (version history & bulk-job logs): admin-only,
    // not world-readable. More specific than the catch-all below, so it wins.
    match /projects/altftool/blogRevisions/{revisionId} {
      allow read, write: if isActiveAdmin();
    }

    match /projects/altftool/blogBulkJobs/{jobId} {
      allow read, write: if isActiveAdmin();
    }

    // Content automation (blog + SEO lanes): admin-only, never world-readable.
    // Server lanes write via the Admin SDK (bypasses rules); these matches gate
    // the admin UI's client SDK and shield the world-readable catch-all below.
    match /projects/altftool/blogTopics/{topicId} {
      allow read, write: if isActiveAdmin();
    }

    match /projects/altftool/blogAutomationRuns/{runId} {
      allow read: if isActiveAdmin();
      allow write: if false; // run logs are server-authored only
    }

    match /projects/altftool/seoProposals/{proposalId} {
      allow read, write: if isActiveAdmin();
    }

    match /projects/altftool/settings/{settingId} {
      allow read, write: if isActiveAdmin();
    }

    // Landing Page CMS: pages are world-readable (the public /lander/[slug]
    // route renders published pages); revisions are admin-only so draft history
    // is never exposed by the world-readable catch-all below.
    match /projects/altftool/landers/{landerId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/altftool/landerRevisions/{revisionId} {
      allow read, write: if isActiveAdmin();
    }

    match /projects/altftool/{document=**} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    // Public newsletter opt-in: create-only with strict shape validation.
    // Deliberately a top-level collection — subscriber emails must NEVER live
    // under the world-readable /projects/altftool/** wildcard above.
    match /newsletter_subscribers/{subscriberId} {
      allow read, update, delete: if isActiveAdmin();
      allow create: if hasOnly(["email", "source", "createdAt"]) &&
        nonEmptyText(request.resource.data.email, 200) &&
        request.resource.data.email.matches('.+@.+[.].+') &&
        request.resource.data.source is string &&
        request.resource.data.source.size() <= 60 &&
        request.resource.data.createdAt == request.time;
    }

    match /projects/carrerbook/footer/settings {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/carrerbook/footerEmails/{emailId} {
      allow read, update, delete: if isActiveAdmin();
      allow create: if hasOnly(["email", "status", "createdAt"]) &&
        request.resource.data.status == "unread" &&
        nonEmptyText(request.resource.data.email, 254);
    }

    match /projects/carrerbook/contact/settings {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/carrerbook/contactLeads/{leadId} {
      allow read, update, delete: if isActiveAdmin();
      allow create: if hasOnly([
          "name",
          "email",
          "website",
          "skypeId",
          "companyName",
          "queryType",
          "message",
          "status",
          "createdAt"
        ]) &&
        request.resource.data.status == "new" &&
        nonEmptyText(request.resource.data.name, 120) &&
        nonEmptyText(request.resource.data.email, 254) &&
        nonEmptyText(request.resource.data.message, 3000);
    }

    match /projects/carrerbook/contact/settings/submissions/{leadId} {
      allow read, update, delete: if isActiveAdmin();
      allow create: if hasOnly([
          "name",
          "email",
          "website",
          "skypeId",
          "companyName",
          "queryType",
          "message",
          "status",
          "createdAt",
          "source"
        ]) &&
        request.resource.data.status == "new" &&
        nonEmptyText(request.resource.data.name, 120) &&
        nonEmptyText(request.resource.data.email, 254) &&
        nonEmptyText(request.resource.data.message, 3000);
    }

    match /projects/carrerbook/contact-us/settings {
      allow read: if true;
      allow write: if isActiveAdmin();

      match /submissions/{leadId} {
        allow read, update, delete: if isActiveAdmin();
        allow create: if hasOnly([
            "name",
            "email",
            "website",
            "skypeId",
            "companyName",
            "queryType",
            "message",
            "status",
            "createdAt",
            "source"
          ]) &&
          request.resource.data.status == "new" &&
          nonEmptyText(request.resource.data.name, 120) &&
          nonEmptyText(request.resource.data.email, 254) &&
          nonEmptyText(request.resource.data.message, 3000);
      }
    }

    // GrowVibe website content — publicly readable, admin-managed.
    match /projects/growvibe/content/{sectionId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    // GrowVibe contact-form leads — anonymous create with strict field
    // validation; reading/managing is admin-only.
    match /projects/growvibe/leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(
          ["name", "email", "phone", "service", "message", "status", "createdAt"]
        ) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.email is string && request.resource.data.email.size() > 3;
      allow read, update, delete: if isActiveAdmin();
    }

    // Coozter contact-form leads — anonymous create with strict field
    // validation; reading/managing is admin-only.
    match /projects/coozter/leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(
          ["budget", "company", "createdAt", "email", "message", "name", "phone", "service", "status", "website"]
        ) &&
        request.resource.data.status == "new" &&
        nonEmptyText(request.resource.data.name, 120) &&
        nonEmptyText(request.resource.data.email, 254) &&
        nonEmptyText(request.resource.data.message, 3000);
      allow read, update, delete: if isActiveAdmin();
    }

    match /projects/carrerbook/homesection/{sectionId} {
      allow read: if true;
      allow write: if isActiveAdmin();

      match /services/{serviceId} {
        allow read: if true;
        allow write: if isActiveAdmin();
      }

      match /features/{featureId} {
        allow read: if true;
        allow write: if isActiveAdmin();
      }

      match /faqs/{faqId} {
        allow read: if true;
        allow write: if isActiveAdmin();
      }

      match /cards/{cardId} {
        allow read: if true;
        allow write: if isActiveAdmin();
      }

      match /{marketingTable}/{rowId} {
        allow read: if marketingTable in ["cpl", "cps", "cpi"];
        allow write: if marketingTable in ["cpl", "cps", "cpi"] && isActiveAdmin();
      }
    }

    match /projects/carrerbook/advertiser/{sectionId} {
      allow read: if true;
      allow write: if isActiveAdmin();

      match /cards/{cardId} {
        allow read: if true;
        allow write: if isActiveAdmin();
      }
    }

    match /projects/carrerbook/publisher/{sectionId} {
      allow read: if true;
      allow write: if isActiveAdmin();

      match /cards/{cardId} {
        allow read: if true;
        allow write: if isActiveAdmin();
      }
    }

    match /projects/carrerbook/about-us/{sectionId} {
      allow read: if true;
      allow write: if isActiveAdmin();

      match /cards/{cardId} {
        allow read: if true;
        allow write: if isActiveAdmin();
      }
    }

    match /projects/carrerbook/team/settings {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/carrerbook/teamMembers/{memberId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    // Anslic tenant — public marketing site content, admin-managed.
    match /projects/anslic/navbar/settings {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/anslic/navbarItems/{itemId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/anslic/footer/settings {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/anslic/stats/settings {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/anslic/homesection/{sectionId} {
      allow read: if true;
      allow write: if isActiveAdmin();

      match /items/{itemId} {
        allow read: if true;
        allow write: if isActiveAdmin();
      }
    }

    match /projects/anslic/about/{sectionId} {
      allow read: if true;
      allow write: if isActiveAdmin();

      match /items/{itemId} {
        allow read: if true;
        allow write: if isActiveAdmin();
      }
    }

    match /projects/anslic/services/settings {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/anslic/serviceItems/{serviceId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/anslic/team/settings {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/anslic/teamMembers/{memberId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/anslic/blog/settings {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/anslic/blogArticles/{blogId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/anslic/contact/settings {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    // Anslic contact-form leads — anonymous create with strict field
    // validation; reading/managing is admin-only. Mirrors the coozter/leads
    // pattern above.
    match /projects/anslic/contactLeads/{leadId} {
      allow create: if hasOnly(["name", "email", "phone", "service", "message", "status", "createdAt"]) &&
        request.resource.data.status == "new" &&
        nonEmptyText(request.resource.data.name, 120) &&
        nonEmptyText(request.resource.data.email, 254) &&
        nonEmptyText(request.resource.data.message, 3000);
      allow read, update, delete: if isActiveAdmin();
    }

    // Infodrif tenant — public marketing site content, admin-managed.
    // Without these blocks the catch-all below makes every collection
    // admin-only, and the unauthenticated site renders its JSON fallback
    // forever instead of anything the admin publishes.
    match /projects/infodrif/navbar/settings {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/infodrif/navbarItems/{itemId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/infodrif/footer/settings {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    // One collection for all four footer link groups, discriminated by a
    // `group` field (company | topics | social | legal).
    match /projects/infodrif/footerLinks/{linkId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    // Section singletons carry named item subcollections rather than a single
    // `items` list — hero has rotatingWords/customerAvatars/teamAvatars and
    // showcase has row1/row2/row3, so the extra {listId} level is required.
    match /projects/infodrif/homesection/{sectionId} {
      allow read: if true;
      allow write: if isActiveAdmin();

      match /{listId}/{itemId} {
        allow read: if true;
        allow write: if isActiveAdmin();
      }
    }

    match /projects/infodrif/about/{sectionId} {
      allow read: if true;
      allow write: if isActiveAdmin();

      match /{listId}/{itemId} {
        allow read: if true;
        allow write: if isActiveAdmin();
      }
    }

    match /projects/infodrif/partners/{sectionId} {
      allow read: if true;
      allow write: if isActiveAdmin();

      match /{listId}/{itemId} {
        allow read: if true;
        allow write: if isActiveAdmin();
      }
    }

    // `settings` (list page copy) and `detail` (article page chrome).
    match /projects/infodrif/blog/{sectionId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/infodrif/blogCategories/{categoryId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/infodrif/blogArticles/{blogId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/infodrif/offers/settings {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/infodrif/offerItems/{offerId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/infodrif/contact/settings {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    match /projects/infodrif/seoRoutes/{routeId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    // Infodrif contact-form leads — anonymous create with strict field
    // validation; reading/managing is admin-only. Mirrors the anslic pattern
    // above, minus the phone/service fields this form does not collect.
    match /projects/infodrif/contactLeads/{leadId} {
      allow create: if hasOnly(["name", "email", "message", "status", "createdAt"]) &&
        request.resource.data.status == "new" &&
        nonEmptyText(request.resource.data.name, 120) &&
        nonEmptyText(request.resource.data.email, 254) &&
        nonEmptyText(request.resource.data.message, 3000);
      allow read, update, delete: if isActiveAdmin();
    }

    match /projects/{projectId}/{document=**} {
      allow read, write: if isActiveAdmin();
    }

    // Google Search Console: OAuth tokens are encrypted and must NEVER be
    // client-readable. Synced metrics are server-written only. The Admin SDK
    // (server routes) bypasses these rules.
    match /integrations/{document=**} {
      allow read, write: if false;
    }

    match /gscDailyMetrics/{docId} {
      allow read, write: if false;
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow update: if onlyChanges(["commentsCount", "likesCount", "views", "viewsCount"]);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if hasOnly(["createdAt", "text"]) &&
          nonEmptyText(request.resource.data.text, 2000);
      }

      match /views/{viewId} {
        allow read: if false;
        allow create: if hasOnly(["viewedAt"]);
      }
    }

    match /results/{resultId} {
      allow read, delete: if true;
      allow create: if hasOnly(["result", "timestamp", "url"]) &&
        nonEmptyText(request.resource.data.url, 2048);
    }

    match /support_tickets/{ticketId} {
      allow read, write: if isActiveAdmin() ||
        (signedIn() && resource.data.createdBy == request.auth.uid);

      match /messages/{messageId} {
        allow read, write: if isActiveAdmin() ||
          (signedIn() && get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.createdBy == request.auth.uid);
      }
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isActiveAdmin();
    }

    match /notification_broadcasts/{broadcastId} {
      allow read, write: if isSuperAdmin();
    }

    // Security & Audit module: all access is mediated by server-side Admin SDK
    // routes (RBAC-checked). Clients must never read/write these directly.
    match /admin_sessions/{id}        { allow read, write: if false; }
    match /admin_devices/{id}         { allow read, write: if false; }
    match /admin_consents/{id}        { allow read, write: if false; }
    match /security_events/{id}       { allow read, write: if false; }
    match /security_settings/{id}     { allow read, write: if false; }
    match /security_login_attempts/{id} { allow read, write: if false; }
    match /admin_audit_logs/{id}      { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
