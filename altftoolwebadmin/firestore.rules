      allow read: if true;
      allow write: if isActiveAdmin();
    }
    match /projects/snapagee/contact/{docId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }
    match /projects/snapagee/contactOffices/{itemId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }
