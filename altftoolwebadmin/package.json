{
  "name": "admin-altftools",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/generate-tool-slugs.mjs && next dev --webpack",
    "build": "node scripts/generate-tool-slugs.mjs && node ../scripts/generate-admin-health-manifest.mjs && next build --webpack",
    "start": "next start",
    "firebase:admin-write-check": "node scripts/checkFirebaseAdminWrite.mjs",
    "firebase:admin-write-check:dry-run": "FIREBASE_ADMIN_WRITE_CHECK_MODE=dry-run node scripts/checkFirebaseAdminWrite.mjs",
    "test:firebase-rules": "node ../tests/firebase-rules.test.mjs",
    "test:admin-crud": "node ../tests/admin-crud-emulator.test.mjs",
    "test:admin-web-sync": "node ../tests/admin-web-sync-emulator.test.mjs"
  },
  "dependencies": {
    "@altftool/core": "file:../packages/core",
    "@altftool/ui": "file:../packages/ui",
    "@ckeditor/ckeditor5-react": "^11.1.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.16.0",
    "dompurify": "^3.4.2",
    "dotenv": "^17.3.1",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0",
    "jszip": "^3.10.1",
    "lighthouse": "12.6.1",
    "lucide-react": "^0.575.0",
    "next": "^16.2.6",
    "papaparse": "^5.5.3",
    "react": "^19.2.5",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "react-select": "^5.10.2",
    "read-excel-file": "^9.0.9",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.1"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "postcss": "^8.5.14",
    "uuid": "^9.0.1",
    "next": {
      "postcss": "^8.5.14"
    }
  }
