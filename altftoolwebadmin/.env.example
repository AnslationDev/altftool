# Environment variables for altftoolwebadmin (the internal admin console).
#
# Copy this file to `.env.local` and fill in real values before running
# `npm run dev`. See docs/DEVELOPER_GUIDE.md for the full auth/RBAC/Firestore
# picture these variables plug into. Never commit `.env.local` — only this
# template (`.env.example`) is tracked in git.

# ── Firebase Admin SDK (server-only) ─────────────────────────────────────────
# A service-account key for the Firebase project this console manages.
# Provide EITHER the three discrete fields below, OR a path to the JSON key
# file via FIREBASE_SERVICE_ACCOUNT_FILE — check src/lib/firebaseAdmin.js for
# which one this app currently reads.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences if pasting a raw PEM key into one line.
FIREBASE_PRIVATE_KEY=
# Alternative to the three fields above: an absolute path to a service-account
# JSON file. Keep it OUTSIDE ~/Downloads on macOS — TCC (Transparency, Consent
# and Control) can silently block the Node dev-server process from reading
# files there even though a shell `cat` in the same directory succeeds.
FIREBASE_SERVICE_ACCOUNT_FILE=

# ── Firebase Client SDK (public — safe to expose to the browser) ────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push (FCM) VAPID key, for admin notification push.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Site URLs ─────────────────────────────────────────────────────────────────
# The public site this admin console manages content for.
ALTFT_PUBLIC_SITE_URL=https://altftool.com
ALTFT_WEB_BASE_URL=https://altftool.com
NEXT_PUBLIC_SITE_URL=https://altftool.com
NEXT_PUBLIC_ALTFT_SITE_URL=https://altftool.com
NEXT_PUBLIC_MAIN_SITE_URL=https://altftool.com
# Used by monitoring/QA scripts to reach the web app from the admin app.
ALTFT_MONITOR_WEB_URL=
ALTFT_WEB_INVENTORY_URL=
ALTFT_WEB_REVALIDATE_URL=
ALTFT_PUBLIC_RUNTIME_QA_URL=

# ── Local development ────────────────────────────────────────────────────────
# Enables the "Continue as Local Admin" button on /login and the
# NODE_ENV=development-only local-dev bypass token — never reachable in a
# production build regardless of this flag. See src/lib/localAdminSession.js
# and src/lib/adminAccess.js.
NEXT_PUBLIC_DEV_BYPASS_AUTH=true
NEXT_PUBLIC_DISABLE_LOCAL_ADMIN=
NEXT_PUBLIC_USE_MOCK=

# ── Google Search Console OAuth (SEO module) ─────────────────────────────────
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REDIRECT_URI=
# Signs the OAuth state param; encrypts stored GSC tokens at rest.
GSC_OAUTH_STATE_SECRET=
GSC_TOKEN_ENC_KEY=
ALTFT_GSC_SYNC_SECRET=

# ── Security / secrets ───────────────────────────────────────────────────────
# Encrypts masked IP addresses at rest (src/lib/security/primitives.js).
SECURITY_IP_ENC_KEY=
# Shared secret cron/webhook callers must present (revalidation, GSC sync).
ALTFT_REVALIDATE_SECRET=
CRON_SECRET=
# Only used to seed the very first superadmin — see scripts/seed-superadmin.mjs.
SEED_ADMIN_PASSWORD=

# ── Third-party integrations ─────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
YOUTUBE_API_KEY=
NEXT_PUBLIC_CKEDITOR_LICENSE_KEY=

# ── Tuning / diagnostics (all optional — sane defaults exist in code) ────────
ALTFT_ADMIN_HEALTH_CACHE_MS=
ALTFT_ADMIN_HEALTH_RATE_LIMIT=
ALTFT_ADMIN_FIREBASE_INTEGRITY_SAMPLE_LIMIT=
ALTFT_REGISTRY_TTL_MS=
ALTFT_PRODUCTION_MONITOR_SLOW_MS=
ALTFT_PRODUCTION_MONITOR_TIMEOUT_MS=
NEXT_PUBLIC_ALTFT_ADMIN_FIREBASE_STALE_READ_MS=

# ── Feature flags used by specific screens/tools ─────────────────────────────
NEXT_PUBLIC_AD_FIX_VIEWPORT=
NEXT_PUBLIC_BLOG_EXPORT=
NEXT_PUBLIC_BLOG_PREVIEW=
NEXT_PUBLIC_FIX_CKEDITOR_WRITE=
