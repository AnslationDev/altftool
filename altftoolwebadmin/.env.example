# ALTFTool Admin — environment template (copy to .env.local; NEVER commit real values)

# ── Content Automation (AI lanes) ──
# Master switch: the automation APIs/cron are fully inert unless "true".
ALTFT_CONTENT_AUTOMATION_ENABLED=false
# Shared secret for the hourly cron → /api/automation/run (x-cron-secret header).
AUTOMATION_CRON_SECRET=
# AI providers — server-side ONLY. OpenAI is the default provider.
OPENAI_API_KEY=
# Optional alternates (select per-lane in Automation → Settings):
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── Firebase Admin (existing) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
